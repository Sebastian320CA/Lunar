{
  "name": "@lunar/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "decoders": "node ../../packages/scene3d/scripts/copy-decoders.mjs",
    "dev": "pnpm run decoders && vite --mode demo",
    "build": "tsc --noEmit && pnpm run decoders && vite build --mode production",
    "build:demo": "pnpm run decoders && vite build --mode demo --outDir dist-demo",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "jsdom": "31.0.1",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@lunar/contracts": "workspace:*",
    "@lunar/security": "workspace:*",
    "@lunar/compare": "workspace:*",
    "@lunar/edu": "workspace:*",
    "@lunar/edu-games": "workspace:*",
    "@lunar/energy": "workspace:*",
    "@lunar/ephemeris": "workspace:*",
    "@lunar/export": "workspace:*",
    "@lunar/i18n": "workspace:*",
    "@lunar/scene3d": "workspace:*",
    "@lunar/sites": "workspace:*",
    "@lunar/sky": "workspace:*",
    "@lunar/solar-view": "workspace:*",
    "@lunar/terrain": "workspace:*",
    "@lunar/ui": "workspace:*"
  }
}
